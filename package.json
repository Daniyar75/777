{
  "name": "network-crm",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "test": "pnpm -r --if-present --workspace-concurrency=1 run test",
    "lint": "pnpm -r --if-present run lint",
    "db:migrate": "pnpm --filter @network-crm/database run migrate",
    "db:generate": "pnpm --filter @network-crm/database run generate"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
